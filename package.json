{
  "name": "@kinetographdev/studio",
  "version": "0.3.0-vitalik.1",
  "description": "kinetograph studio: a local web server and browser UI whose preview frames the addon renders",
  "license": "PolyForm-Small-Business-1.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./packages/studio/dist/index.d.ts",
      "default": "./packages/studio/dist/index.js"
    },
    "./protocol": {
      "types": "./packages/studio/dist/protocol.d.ts",
      "default": "./packages/studio/dist/protocol.js"
    }
  },
  "files": [
    "packages/studio/dist",
    "packages/studio/catalog",
    "packages/studio/ui/dist",
    "packages/studio/package.json"
  ],
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.0.2",
    "@kinetographdev/audio": "0.3.0",
    "@kinetographdev/core": "0.3.0",
    "@kinetographdev/native": "0.3.0",
    "@kinetographdev/scene": "0.3.0",
    "kinetograph": "github:vitalikprac/kinetograph#dist-cli",
    "ws": "8.22.0"
  },
  "engines": {
    "node": ">=22"
  }
}