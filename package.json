      "types": "./packages/cli/dist/index.d.ts",
      "default": "./packages/cli/dist/index.js"
    }
  },
  "files": [
    "packages/cli/dist",
    "packages/cli/skills",
    "packages/cli/assets",
    "packages/cli/package.json"
  ],
  "dependencies": {
    "@kinetographdev/audio": "0.3.0",
    "@kinetographdev/compat": "0.3.0",
    "@kinetographdev/core": "0.3.0",
    "@kinetographdev/native": "0.3.0",
    "@kinetographdev/scene": "0.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "esbuild": "0.28.2",
    "parse5": "8.0.1",
    "postcss": "8.5.30",
    "typescript": "5.9.3",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=22"
  }
}